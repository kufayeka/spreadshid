{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@kufayeka/sheet": ["../../dist/types/index.d.ts"],
      "@kufayeka/sheet/core": ["../../dist/types/core/index.d.ts"],
      "@kufayeka/sheet/style.css": ["./style.d.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "gambar/*.tsx"]
}
